# 'local' → writes to ./local-queue/  |  'servicebus' → Azure Service Bus
TRANSPORT=local
LOCAL_QUEUE_DIR=./local-queue

# Azurite default — works out of the box with docker-compose up
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UKvz68Kz1SMh0/SA==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Only required when TRANSPORT=servicebus
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE=law-changes

LOG_LEVEL=info
