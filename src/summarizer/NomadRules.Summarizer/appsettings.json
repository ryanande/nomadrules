{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "//": "Point this at the same SQLite file the API writes. Relative paths resolve to the worker's working dir.",
    "Sqlite": "Data Source=../../api/NomadRules.Api/nomadrules.db"
  },
  "Claude": {
    "//": "ApiKey falls back to the ANTHROPIC_API_KEY env var when omitted.",
    "ApiKey": "",
    "Model": "claude-opus-4-8",
    "InputCostPer1M": 5.0,
    "OutputCostPer1M": 25.0,
    "TimeoutSeconds": 30
  },
  "Summarizer": {
    "PollSeconds": 15,
    "MaxRetries": 2,
    "QuotaBackoffMinutes": 60,
    "ReviewThreshold": 10
  }
}
