{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "//": "Point this at the same local Postgres the API writes (see infra/docker-compose.yml).",
    "Postgres": "Host=localhost;Port=5432;Database=nomadrules_dev;Username=nomadrules;Password=nomadrules"
  },
  "Claude": {
    "//": "ApiKey falls back to the ANTHROPIC_API_KEY env var when omitted.",
    "ApiKey": "",
    "Model": "claude-opus-4-8",
    "InputCostPer1M": 5.0,
    "OutputCostPer1M": 25.0,
    "TimeoutSeconds": 30
  },
  "Summarizer": {
    "PollSeconds": 15,
    "MaxRetries": 2,
    "QuotaBackoffMinutes": 60,
    "ReviewThreshold": 10
  }
}
